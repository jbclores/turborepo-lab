{
  "name": "turborepo-lab",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbclores/turborepo-lab.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jbclores/turborepo-lab/issues"
  },
  "homepage": "https://github.com/jbclores/turborepo-lab#readme",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "jest": "^30.5.2",
    "turbo": "^2.11.6",
    "typescript": "^7.0.2"
  }
}

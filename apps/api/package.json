{
  "name": "@lab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@lab/db": "^0.0.0",
    "@lab/schemas": "^0.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}

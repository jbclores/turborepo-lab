# Copy to .env and choose your own password. Never commit .env.
# Used by docker compose (the POSTGRES_* values) and by the db package and API (the *DATABASE_URL values).

POSTGRES_USER=lab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lab_dev
POSTGRES_PORT=5432

# The password in these URLs must match POSTGRES_PASSWORD.
DATABASE_URL=postgres://lab:change-me@localhost:5432/lab_dev
TEST_DATABASE_URL=postgres://lab:change-me@localhost:5432/lab_test
